{
  "name": "naesaekku",
  "version": "0.9.5",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "내 반려동물과 바탕화면에서 함께하는 데스크톱 펫",
  "author": "내새꾸, 내곁에",
  "scripts": {
    "build": "vite build",
    "start": "electron .",
    "studio": "electron . --studio",
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "node server/preview.mjs",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
    "dist:portable": "npm run build && electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "gifenc": "1.0.3",
    "lucide-react": "1.47.0",
    "openai": "7.18.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.1",
    "electron": "44.4.2",
    "electron-builder": "26.15.3",
    "prettier": "^3.9.8",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "build": {
    "appId": "local.ongi.studio",
    "productName": "내새꾸, 내곁에",
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "core/**",
      "server/**",
      "assets/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "portable": {
      "artifactName": "내새꾸, 내곁에.exe"
    },
    "publish": null,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "내새꾸-내곁에-Setup-${version}.${ext}",
      "uninstallDisplayName": "내새꾸, 내곁에"
    }
  }
}
